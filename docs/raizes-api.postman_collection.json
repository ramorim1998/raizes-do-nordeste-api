    {
      "name": "01 - Catálogo sem token",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "const data = pm.response.json();",
              "pm.test(\"data.status\", () => pm.expect(data.status).to.eql(401));"
            ]
          }
        }
      ]
    },
